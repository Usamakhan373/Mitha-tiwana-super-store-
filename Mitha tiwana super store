"use client";
import { useState, useEffect } from "react";
import { initializeApp, getApps, getApp } from "firebase/app";
import { getFirestore, collection, addDoc, getDocs, deleteDoc, doc, query, orderBy } from "firebase/firestore";

// --- MITHA TIWANA STORE REAL credentials ---
const firebaseConfig = {
  apiKey: "AIzaSyD-placeholder-apna-yahan-dalo", // Yara isko bas deployment ke waqt active rakhna
  authDomain: "://firebaseapp.com",
  projectId: "mitha-tiwana-store",
  storageBucket: "://appspot.com",
  messagingSenderId: "123456789",
  appId: "1:123456789:web:abcdef"
};

const app = getApps().length ? getApp() : initializeApp(firebaseConfig);
const db = getFirestore(app);

export default function Page() {
  const [products, setProducts] = useState([]);
  const [search, setSearch] = useState("");
  const [admin, setAdmin] = useState(false);
  const [login, setLogin] = useState(false);
  const [pass, setPass] = useState("");
  const [form, setForm] = useState({ name: "", price: "", image: "" });
  const [loading, setLoading] = useState(true);

  const EASYPAISA_NUMBER = "03247296703";
  const WHATSAPP = "923247296703";

  const load = async () => {
    setLoading(true);
    try {
      const q = query(collection(db, "products"), orderBy("createdAt", "desc"));
      const s = await getDocs(q);
      setProducts(s.docs.map(d => ({ id: d.id, ...d.data() })));
    } catch (err) {
      console.error("Load Error:", err.message);
    } finally {
      setLoading(false);
    }
  };
  useEffect(() => { load(); }, []);

  const onImage = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const r = new FileReader();
    r.onload = (ev) => {
      const img = new Image();
      img.onload = () => {
        const c = document.createElement("canvas");
        c.width = 600;
        c.height = img.height * (600 / img.width);
        c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
        setForm({ ...form, image: c.toDataURL("image/jpeg", 0.6) });
      };
      img.src = ev.target.result;
    };
    r.readAsDataURL(file);
  };

  const add = async () => {
    try {
      if (!form.name || !form.price || !form.image) return alert("Sab bharo");
      await addDoc(collection(db, "products"), { ...form, createdAt: Date.now() });
      setForm({ name: "", price: "", image: "" });
      alert("Product uploaded smoothly!");
      load();
    } catch (err) {
      console.error("Add Error:", err.message);
      alert(err.message);
    }
  };

  const del = async (id) => {
    try {
      if (!confirm("Delete?")) return;
      await deleteDoc(doc(db, "products", id));
      load();
    } catch (err) {
      console.error("Delete Error:", err.message);
    }
  };

  const list = products.filter(p => p.name.toLowerCase().includes(search.toLowerCase()));

  return (
    <div className="min-h-screen bg-gray-50 pb-24 font-sans">
      <header className="bg-green-700 text-white p-4 flex justify-between items-center sticky top-0 z-40 shadow-sm">
        <div>
          <h1 className="font-extrabold text-base">Mitha Tiwana Super Store</h1>
          <p className="text-[10px] text-green-100">Khushab Delivery Active</p>
        </div>
        <button onClick={() => setAdmin(true)} className="bg-white text-green-700 px-4 py-1.5 rounded-full text-xs font-bold shadow-sm">Owner Panel</button>
      </header>

      <div className="p-4 max-w-xl mx-auto">
        <input value={search} onChange={e => setSearch(e.target.value)} placeholder="🔍 Products search karein..." className="w-full border border-gray-200 p-3 rounded-2xl bg-white shadow-sm focus:outline-none" />
      </div>

      <main className="max-w-6xl mx-auto p-4">
        {loading ? (
          <p className="text-center py-20 text-gray-400 text-sm">Loading...</p>
        ) : list.length === 0 ? (
          <p className="text-center py-20 text-gray-400 text-sm">Koi item nahi mila.</p>
        ) : (
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            {list.map(p => (
              <div key={p.id} className="bg-white rounded-2xl border border-gray-100 p-3 flex flex-col justify-between shadow-sm">
                <div>
                  <img src={p.image} alt={p.name} className="h-36 w-full object-cover rounded-xl bg-gray-50" />
                  <h3 className="font-bold text-xs mt-2 text-gray-800 line-clamp-2">{p.name}</h3>
                  <p className="text-red-600 font-extrabold text-sm mt-1">Rs. {p.price}</p>
                </div>
                <div className="mt-2 space-y-1">
                  <a href={`https://wa.me{WHATSAPP}?text=Salam,%20mujhe%20ye%20item%20chahiye:%20${encodeURIComponent(p.name)}`} target="_blank" className="block text-center bg-[#25D366] text-white py-2 rounded-xl text-xs font-bold shadow-sm hover:bg-green-600">🟢 WhatsApp Order</a>
                  {login && (
                    <button onClick={() => del(p.id)} className="w-full bg-red-50 text-red-600 py-1 rounded-lg text-[10px] font-bold">Remove Stock</button>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </main>

      {admin && (
        <div className="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl p-5 w-full max-w-sm shadow-xl relative">
            <button onClick={() => setAdmin(false)} className="absolute top-4 right-4 text-gray-400 font-bold">✕</button>
            {!login ? (
              <div>
                <h2 className="font-black text-xl text-gray-800">Owner Login</h2>
                <input type="password" value={pass} onChange={e => setPass(e.target.value)} placeholder="Mitha@123" className="w-full border p-3 rounded-xl mt-4 focus:outline-none" />
                <button onClick={() => { if (pass === "Mitha@123") setLogin(true); else alert("Wrong Password"); }} className="w-full bg-green-700 text-white py-3 rounded-xl mt-3 font-bold shadow-md">Verify Admin</button>
              </div>
            ) : (
              <div className="space-y-3">
                <h2 className="font-bold text-lg text-gray-800">Add Product</h2>
                <input value={form.name} onChange={e => setForm({ ...form, name: e.target.value })} placeholder="Item Name" className="w-full border p-2.5 rounded-xl text-sm" />
                <input value={form.price} onChange={e => setForm({ ...form, price: e.target.value })} placeholder="Price" className="w-full border p-2.5 rounded-xl text-sm" />
                <input type="file" accept="image/*" onChange={onImage} className="w-full mt-2 text-xs text-gray-500 file:mr-2 file:py-1 file:px-2 file:rounded-lg file:border-0 file:bg-green-50 file:text-green-700" />
                {form.image && <img src={form.image} alt="preview" className="h-16 mx-auto rounded shadow-sm" />}
                <button onClick={add} className="w-full bg-blue-600 text-white py-2.5 rounded-xl mt-2 font-bold shadow-sm">Upload to Store</button>
              </div>
            )}
          </div>
        </div>
      )}

      <footer className="fixed bottom-0 left-0 right-0 bg-white border-t p-3 flex justify-around items-center z-40 shadow-md">
        <div className="text-center">
          <p className="text-[9px] text-gray-400 font-bold uppercase">EasyPaisa Account</p>
          <p className="text-xs font-black text-gray-800">{EASYPAISA_NUMBER}</p>
        </div>
        <div className="h-5 w-px bg-gray-200"></div>
        <a href={`https://wa.me{WHATSAPP}`} target="_blank" className="bg-[#25D366] text-white px-5 py-2 rounded-full text-xs font-bold shadow-sm">Chat on WhatsApp</a>
      </footer>
    </div>
  );
}
